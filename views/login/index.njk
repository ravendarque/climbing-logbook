<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Log in – Climbing Logbook</title>
  <link rel="icon" type="image/png" sizes="32x32" href="/-/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/-/favicon-16.png">
  <meta name="theme-color" content="#ff2727">
  <link rel="preload" as="font" type="font/woff2" href="/-/fonts/BebasNeue-Regular.woff2" crossorigin>
  <link rel="stylesheet" href="/-/tailwind.css{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}">
  <link rel="preload" as="image" type="image/svg+xml" href="/-/brand-lockup.svg{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}">
  <script src="/-/components/climbing-header.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
  <script>
    // Same pre-paint theme bootstrap as public/-/index.html --
    // must run synchronously here, not deferred/module, or the browser
    // paints the wrong theme first and flashes.
    (function () {
      var stored = localStorage.getItem("logbook_theme");
      var theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body class="bg-background text-foreground font-sans min-h-screen flex items-center justify-center px-4">
  {# display:none, not [hidden], so it doesn't depend on the stylesheet having loaded. #}
  <div class="flex flex-col items-center gap-6" id="page-content" style="display:none">
    <climbing-header variant="brand"></climbing-header>
    <form class="w-full max-w-[360px] bg-surface border border-border rounded-app p-6" id="login-form" novalidate>
      <label class="block text-sm text-muted mb-1" for="email">Email</label>
      <input
        class="text-input w-full mb-4"
        type="email" id="email" name="email" required autocomplete="email">

      <label class="block text-sm text-muted mb-1" for="password">Password</label>
      <input
        class="text-input w-full mb-2"
        type="password" id="password" name="password" required autocomplete="current-password">

      <p class="text-sm text-right mb-4">
        <button type="button" class="text-accent bg-transparent border-0 p-0 cursor-pointer" id="forgot-password-btn">Forgot password?</button>
      </p>

      <p class="mb-4 error-message" id="login-error" role="alert" aria-live="assertive" tabindex="-1" hidden></p>
      <p class="text-sm text-muted mb-4" id="login-info" hidden></p>

      <button type="submit" class="btn btn-primary w-full disabled:opacity-[.45] disabled:cursor-not-allowed" id="login-submit-btn">Log in</button>

      <p class="text-sm text-muted mt-4 text-center">
        Don't have an account? <a class="text-accent" href="/register/">Sign up</a>
      </p>
    </form>
  </div>
  <script type="module">
    import { redirectIfLoggedIn } from "/-/session-redirect.js";
    redirectIfLoggedIn(document.getElementById("page-content"));
  </script>
  <script type="module" src="/-/login/login.js"></script>
</body>
</html>
