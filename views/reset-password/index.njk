<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset password – Climbing Logbook</title>
  <link rel="icon" type="image/png" sizes="32x32" href="../-/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="../-/favicon-16.png">
  <meta name="theme-color" content="#ff2727">
  <!-- #470 -- starts the brand font fetch during initial parsing rather
       than waiting for layout to discover climbing-header.js's own
       @font-face rule -- see public/index.html's own comment for the
       fuller reasoning. Absolute /-/... here too, not ../-/...
       like the rest of this page's own asset paths -- the preload only
       helps if its URL matches climbing-header.js's own hardcoded
       @font-face url() byte-for-byte. -->
  <link rel="preload" as="font" type="font/woff2" href="/-/fonts/BebasNeue-Regular.woff2" crossorigin>
  <!-- Generated by `pnpm run tailwind:build` (see styles/tailwind.css) --
       not committed, see .gitignore. -->
  <!-- #857 -- the ?v= query (see .eleventy.js's own comment; #961: a per-file content hash in production builds, and deliberately not printed here, since that would make every build's HTML differ)
       lets public/_headers cache these two files immutably; skipped in
       dev (isDevBuild), which doesn't need it (see app-layout.njk's own
       fuller comment on why). -->
  <link rel="stylesheet" href="../-/tailwind.css{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}">
  <!-- Shared design tokens + <climbing-header> Custom Element (#345).
       Classic script, not a module -- must run synchronously here, before
       the [hidden]-dependent markup below and before first paint. See the
       file's own comment for why. -->
  <!-- #1015 -- the brand lockup SVG the header <use>s: fetched during parsing,
       content-hashed by the build, and pre-cached by the service worker. -->
  <link rel="preload" as="image" type="image/svg+xml" href="/-/brand-lockup.svg{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}">
  <script src="../-/components/climbing-header.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
  <script>
    (function () {
      var stored = localStorage.getItem("logbook_theme");
      var theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = theme;
    })();
  </script>
</head>
<body class="bg-background text-foreground font-sans min-h-screen flex flex-col items-center justify-center gap-6 px-4">
  <climbing-header variant="brand"></climbing-header>
  <!-- No in-form heading here -- same pattern login/index.html and
       register/index.html's own initial forms use (the shared brand
       header + <title> already identify the page); reserved for terminal/
       status states below (#reset-invalid/#reset-success), matching
       register/index.html's own "Check your email" success state. Found
       inconsistent (a stray heading here, and at a different margin than
       its own sibling states below) via code review, 2026-08-09. -->
  <form class="w-full max-w-[360px] bg-surface border border-border rounded-app p-6" id="reset-form" novalidate>
    <label class="block text-sm text-muted mb-1" for="password">New password</label>
    <input
      class="text-input w-full mb-4"
      type="password" id="password" name="password" required autocomplete="new-password">

    <!-- #894 -- error-message -- see views/login/index.njk's own
         #login-error comment. -->
    <p class="mb-4 error-message" id="reset-error" role="alert" aria-live="assertive" tabindex="-1" hidden></p>

    <!-- #754 -- btn btn-primary, the same shared CTA class public/
         index.html's own "Sign up"/"Log in" buttons already use --
         see public/login/index.html's own identical comment. -->
    <button type="submit" class="btn btn-primary w-full disabled:opacity-[.45] disabled:cursor-not-allowed" id="reset-submit-btn">Set new password</button>
  </form>

  <!-- Bad/expired/missing token -- Better Auth's own /reset-password/:token
       GET handler redirects here with ?error=INVALID_TOKEN rather than
       ?token=..., which is what tells reset-password.js to show this
       instead of the form at all. -->
  <div class="w-full max-w-[360px] bg-surface border border-border rounded-app p-6 text-center" id="reset-invalid" hidden>
    <h1 class="font-display text-3xl mb-4 tracking-wide">Link expired</h1>
    <p class="text-muted">This password reset link is invalid or has expired. <a class="text-accent" href="../login/">Request a new one</a> from the login page.</p>
  </div>

  <div class="w-full max-w-[360px] bg-surface border border-border rounded-app p-6 text-center" id="reset-success" hidden>
    <h1 class="font-display text-3xl mb-4 tracking-wide">Password updated</h1>
    <p class="text-muted"><a class="text-accent" href="../login/">Log in</a> with your new password.</p>
  </div>

  <script type="module" src="./reset-password.js"></script>
</body>
</html>
