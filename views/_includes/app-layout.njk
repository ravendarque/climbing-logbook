{% if lowercaseDoctype %}<!doctype html>{% else %}<!DOCTYPE html>{% endif %}
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <link rel="manifest" href="/logbook/manifest.json">
  <link rel="icon" type="image/png" sizes="32x32" href="/logbook/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/logbook/favicon-16.png">
  <link rel="apple-touch-icon" href="/logbook/apple-touch-icon.png">
  <meta name="theme-color" content="#ff2727">
  <!-- #470 -- starts the brand font fetch during initial parsing rather
       than waiting for layout to discover climbing-header.js's own
       @font-face rule -- see public/index.html's own comment for the
       fuller reasoning. -->
  <link rel="preload" as="font" type="font/woff2" href="/logbook/fonts/BebasNeue-Regular.woff2" crossorigin>
  <!-- {{ staticShellNote | safe }} -->
  <!-- #857 -- ?v={{ assetVersion }} (see .eleventy.js's own comment)
       lets public/_headers cache these stable-named files immutably --
       a real rebuild changes the query, busting every previously-cached
       copy at once. Skipped entirely in dev (isDevBuild): vite.config.js's
       own devEntryRewrite middleware matches /logbook/<name>-app.js with
       a trailing $ anchor, so any query string on that specific URL would
       stop it from recognizing the request at all; dev mode doesn't need
       this caching anyway (Vite's own dev server + HMR already handles
       freshness). Only {{ bundle }}-app.js is at risk from that specific
       regex, but the query is skipped uniformly here for consistency --
       nothing in dev mode benefits from immutable caching regardless. -->
  <link rel="stylesheet" href="/logbook/tailwind.css{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}">
  <script src="/logbook/components/climbing-header.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
{%- if discipline %}
  <script src="/logbook/components/climbing-discipline-picker.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
{%- endif %}
  <script src="/logbook/components/climbing-burger-menu.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
  <script src="/logbook/components/climbing-page-header.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
  <script>
    (function () {
      var stored = localStorage.getItem("logbook_theme");
      var theme = stored || (matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
      document.documentElement.dataset.theme = theme;
    })();
  </script>
  <!-- #775 (#761 Part 3) -- Vite's own dev-mode HMR client, Vite's
       documented pattern for HTML a backend serves itself (not Vite's
       own index.html handling, which this app deliberately doesn't use
       -- #760's own templating/#758's rejection of letting Vite own
       HTML entries). Originally emitted unconditionally on the
       assumption that /@vite/client "404s harmlessly" once nothing
       serves that path in production -- confirmed false live on beta
       (2026-09-17): Cloudflare's static-asset 404 response has a
       Content-Type Firefox treats as a blocked/corrupted module load,
       not a plain failed request, logging a confusing error on every
       real page load for zero functional benefit (a failed `<script
       type="module">` doesn't block its unrelated siblings, so nothing
       else on the page was actually affected). Gated on isDevBuild
       (.eleventy.js's own ELEVENTY_RUN_MODE check) instead. -->
  {%- if isDevBuild %}
  <script type="module" src="/@vite/client"></script>
  {%- endif %}
</head>
<body class="bg-background text-foreground font-sans px-4 pt-6 pb-16 min-w-[300px]">
{{ content | safe }}
<!-- #876 -- conditional, not unconditional like every other page here:
     views/help/** chains through this layout (help-layout.njk's own
     front matter sets `layout: app-layout.njk`) but is genuinely static
     content with no client-main.js of its own to load -- `bundle` is
     simply never set on those pages. Every existing page keeps setting
     `bundle` in its own front matter, so this changes nothing for them. -->
{%- if bundle %}
<script type="module" src="/logbook/{{ bundle }}-app.js{% if not isDevBuild %}?v={{ assetVersion }}{% endif %}"></script>
{%- endif %}
</body>
</html>
