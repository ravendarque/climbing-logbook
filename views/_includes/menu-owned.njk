{% from "burger-menu.njk" import themeToggle %}
{#- Identity rows and login/logout are revealed at runtime by admin-auth.js / header-chrome.js once the session is known -- both start hidden. The bottom row's border-t divider is toggled by updateMenuDivider() (client/header-chrome.js) depending on whether menu-username is showing. -#}
<div class="self-start max-w-[11rem] truncate text-[.9rem] font-bold text-accent text-left" id="menu-username" hidden></div>
<a class="self-start text-[.9rem] font-semibold text-foreground text-left" id="my-account-link" href="#" hidden>My account</a>
<div class="flex flex-col gap-2 self-stretch pt-2 mt-1 border-t border-border" id="header-menu-bottom-row">
  <a class="text-[.9rem] text-foreground text-left" data-apex-link href="/help/" id="menu-help-link">Help</a>
  <div class="flex items-center gap-3 text-[.85rem]" id="menu-status-row" hidden>
    <span class="text-foreground font-semibold" id="menu-status-text"></span>
  </div>
  <div class="flex items-center justify-between" id="header-menu-actions-row">
    {{ themeToggle() }}<button type="button" class="btn" id="login-toggle-btn">Log in</button>
  </div>
</div>
