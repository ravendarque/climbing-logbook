{% macro statusCard(tone, title, id, hidden) %}
<div class="flex gap-3 px-4 py-[14px] rounded-app border tone-{{ tone }}"{% if id %} id="{{ id }}"{% endif %}{% if hidden %} hidden{% endif %}>
  <svg class="w-[1.2rem] h-[1.2rem] stroke-current fill-none mt-[2px] shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    {%- if tone == "positive" %}<circle cx="12" cy="12" r="10"></circle><path d="m8.5 12.5 2.5 2.5 5-5"></path>
    {%- elif tone == "negative" %}<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0Z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path>
    {%- else %}<circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path>{% endif -%}
  </svg>
  <div class="min-w-0">
    <p class="text-sm leading-[1.5] font-semibold text-foreground">{{ title }}</p>
    <div class="text-sm leading-[1.5] text-foreground mt-1">{{ caller() }}</div>
  </div>
</div>
{% endmacro %}
