<climbing-import class="flex flex-col gap-4">
  <div class="row-card">
    <div class="row-card-title mb-1">1. Download the CSV template</div>
    <p class="text-sm text-muted mb-3">The CSV template has the columns the import expects. Each row is one entry. If you have a JSON export from this app, just go straight to the import.</p>
    <button type="button" class="btn" id="download-template-btn">Download CSV template</button>
  </div>

  <div class="row-card">
    <div class="row-card-title mb-1" id="import-file-label">2. Upload your file</div>
    <p class="text-sm text-muted mb-3">Upload your completed CSV template or your JSON export. Nothing is imported until every entry in the file is valid. Any errors will be listed here so you can fix them and try again.</p>
    <form class="flex flex-wrap items-center gap-2" id="import-form">
      <input class="flex-1 min-w-0 text-sm" id="import-file-input" aria-labelledby="import-file-label" name="file" type="file" accept=".csv,.json,text/csv,application/json" required>
      <button type="submit" class="btn btn-primary shrink-0" id="import-submit-btn">Import</button>
    </form>
  </div>

  <p class="text-sm text-muted" id="import-status" hidden></p>

  <div class="row-card" id="import-errors" hidden>
    <div class="row-card-title mb-2 text-accent-ink">Some rows couldn't be imported</div>
    <ul class="text-sm flex flex-col gap-1 list-disc pl-5" id="import-errors-list"></ul>
  </div>

  <div class="row-card" id="import-success" hidden>
    <div class="row-card-title mb-1">Import complete</div>
    <p class="text-sm text-muted" id="import-success-message"></p>
  </div>
</climbing-import>
