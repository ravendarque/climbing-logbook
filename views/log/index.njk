---
layout: app-layout.njk
title: Logbook – Climbing Logbook
discipline: true
bundle: log
staticShellNote: |-
  Genuinely static shell (#348), same pattern as public/map/index.html
         and public/performance/index.html -- see either file's own comment
         for why every path below is absolute and client/log-main.js reads
         the username from location.pathname itself rather than this file
         being templated.
---
<div class="max-w-[960px] mx-auto">
  <!-- Picker/menu row before the brand row, and align-left on
       <climbing-header> -- matches /logbook's own layout (left-aligned
       brand row below the header row, not centered above it). Found via
       Raven's production report, 2026-08-10 -- see climbing-header.js's
       own comment on the align-left attribute. -->
  <climbing-page-header></climbing-page-header>

  <div class="flex items-end gap-3 mb-5" id="picker-tabs-row">
    <climbing-discipline-picker></climbing-discipline-picker>
    <climbing-tab-bar active-page="log"></climbing-tab-bar>
  </div>

  <!-- add-btn/sync-btn are owned by client/entry-form.js/client/
       offline-sync.js, not <climbing-entries-table> itself -- declared
       here as plain markup (no layout classes needed; the component's
       own SHELL owns that), then reparented by client/log-main.js into
       the component's #entries-table-actions slot once it's connected,
       landing in the same row as its own collapse-all-btn (matching
       /logbook's own layout -- found via Raven's production report,
       2026-08-11: these used to sit in their own row above the search/
       filter bar instead). -->
  <button type="button" class="btn btn-primary min-w-24 justify-center" id="add-btn" hidden>
    <!-- #721 -- relative top-[-1px]: .btn's flexbox align-items:center
         centers the icon and the text SPAN's own bounding boxes
         perfectly (confirmed via getBoundingClientRect() -- both boxes'
         centerY exactly match the button's), but "Add" has no
         descenders, so its actual glyph ink sits in the upper portion
         of its own line box, not centered on it -- the icon (whose ink
         IS centered in its own box, a symmetric rounded-square-plus
         glyph) reads as sitting lower than the text's own visual
         center as a result. A 1px optical nudge, not a layout bug. -->
    <svg class="relative top-[-1px] w-4 h-4 stroke-current fill-none shrink-0" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"></rect><path d="M8 12h8"></path><path d="M12 8v8"></path></svg>
    <span>Add</span>
  </button>
  <button type="button" class="btn min-w-24 justify-center" id="sync-btn" hidden>
    <svg class="w-4 h-4 stroke-current fill-none shrink-0" id="sync-btn-icon" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m2 9 3-3 3 3"></path><path d="M13 18H7a2 2 0 0 1-2-2V6"></path><path d="m22 15-3 3-3-3"></path><path d="M11 6h6a2 2 0 0 1 2 2v10"></path></svg>
    <span id="sync-btn-label">Sync</span>
  </button>

  <!-- loading (#470): true from initial parse, before client/log-main.js's
       own boot() has read/fetched real data -- see that attribute's own
       comment in client/components/climbing-entries-table.js. Cleared by
       boot() itself once real data has resolved. -->
  <climbing-entries-table editable loading></climbing-entries-table>

  <div class="text-center text-muted text-[.78rem] mt-8" id="footer"></div>
</div>

<!-- ══ Add / edit entry modal ════════════════════════════════════════ -->
<div class="fixed inset-0 z-[100] bg-[color-mix(in_srgb,black_60%,transparent)] flex items-start justify-center px-4 py-6 overflow-y-auto" id="entry-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="entry-modal-title" tabindex="-1">
  <div class="bg-background border border-border rounded-app p-5 w-full max-w-[460px]">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-[1.15rem] font-bold text-accent" id="entry-modal-title">Add entry</h2>
      <button type="button" class="border-none bg-transparent cursor-pointer text-muted text-[1.1rem] leading-none p-[.2rem] hover:text-foreground" id="entry-close" aria-label="Close">✕</button>
    </div>

    <form id="entry-form" autocomplete="off">
    <!-- #791 -- two swipeable pages (Athlete Mode only -- entry-form.js's
         own open() hides #entry-nav-forward and pins the form on page 1
         for a logbook-only user, so the page-2 content, while present in
         the DOM, is never reachable there). #entry-pages-viewport clips
         to whichever page is active; #entry-pages-track is the sliding
         flex row both pages are laid out in, translateX'd by
         entry-form.js's own showPage(). Both pages stay inside this ONE
         form (not two separate forms) -- either page's own "Save &
         close" submits the whole entry, both pages' field values
         included, exactly like today's single-page submit.
         items-start (not flex's own default align-items:stretch) -- a
         real bug found live, not a guess: without it, BOTH pages were
         being stretched to match whichever one's content was taller
         (confirmed via getBoundingClientRect(): both reported the exact
         same height regardless of their genuinely different content),
         which made entry-form.js's own scrollHeight-based height
         measurement in showPage() meaningless (both "old" and "new"
         heights read identical), and left real dead space below
         whichever page's own actual content was shorter than its
         stretched box (the "Delete entry button is way down after a lot
         of dead space" report). items-start lets each page size to its
         own real content instead. -->
    <div class="overflow-hidden" id="entry-pages-viewport">
      <div class="flex items-start transition-[transform,height] duration-300 ease-out motion-reduce:transition-none" id="entry-pages-track">
      <div class="w-full shrink-0" id="entry-page-1" tabindex="-1">
      <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2 first:mt-0 mt-[1.1rem]" id="form-name-label">Problem name</div>
      <div class="mb-3">
        <input type="text" class="text-input w-full" id="entry-name" required>
      </div>

      <div class="mb-3">
        <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2">Place</div>
        <div class="relative" id="place-wrap">
          <button type="button" class="w-full flex items-center gap-[.6rem] bg-surface border border-border rounded-app px-[.85rem] py-[.65rem] text-foreground text-[1rem] cursor-pointer hover:border-accent text-left [&_svg]:w-[1.1rem] [&_svg]:h-[1.1rem] [&_svg]:stroke-current [&_svg]:fill-none [&_svg]:shrink-0" id="place-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Place: none selected">
            <span class="flex items-center justify-center shrink-0" id="place-btn-flag" aria-hidden="true"><svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M2 12h20"></path><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20Z"></path></svg></span>
            <span class="truncate text-muted" id="place-btn-label">Select a place…</span>
          </button>
          <div class="absolute top-[calc(100%+.4rem)] left-0 z-20 bg-background border border-border rounded-app p-[.5rem] w-full max-w-[calc(100vw-2rem)] shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="place-popover" hidden>
            <input type="text" class="bg-surface border border-border rounded-app px-[.7rem] py-[.5rem] text-foreground text-[.9rem] outline-none focus:border-accent w-full" id="place-search" placeholder="Search places…" autocomplete="off" aria-label="Search places" aria-controls="place-listbox">
            <button type="button" class="flex items-center gap-[.5rem] w-full mt-[.4rem] px-[.6rem] py-[.5rem] rounded-[calc(var(--radius-app)-2px)] cursor-pointer text-[.9rem] font-semibold text-accent bg-transparent border-0 hover:bg-[color-mix(in_srgb,var(--color-accent)_8%,transparent)] [&_svg]:w-4 [&_svg]:h-4 [&_svg]:stroke-current [&_svg]:fill-none" id="place-add-new-btn">
              <svg viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
              Add new place
            </button>
            <ul class="max-h-[13rem] overflow-y-auto m-0 mt-[.4rem] p-0 list-none" id="place-listbox" role="listbox" aria-label="Place"></ul>
          </div>
        </div>
      </div>

      <!-- Grade/Date were both flex-1 (equal 50/50 split) -- Date's own
           content (a YYYY-MM-DD string + the calendar button) never
           needed half the row, leaving real dead space there while
           Grade's own value button (esp. Font's own "8A+/V17"-shaped
           label+V-scale hint) was visibly cramped. Date now takes a
           fixed, content-sized share (Raven, 2026-09-12); Grade (still
           flex-1) grows to fill whatever's left. -->
      <div class="flex flex-wrap gap-[.6rem] mb-3 mt-[1.1rem]">
        <div class="flex-1 min-w-[9rem]">
          <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2">Grade</div>
          <div class="flex items-stretch gap-2">
            <button type="button" class="flex-[0_0_2.6rem] flex items-center justify-center border border-border rounded-app bg-surface text-foreground cursor-pointer hover:border-accent active:scale-[.94]" id="grade-prev" aria-label="Previous grade">
              <svg class="w-[.8rem] h-[.8rem] fill-current" viewBox="0 0 24 24"><polygon points="16 5 6 12 16 19"></polygon></svg>
            </button>
            <!-- #703 -- button + popover listbox, not a native <select> --
                 a native select's own OPEN dropdown panel is OS/browser-
                 rendered chrome that plain CSS can't restyle to match this
                 app's own popover convention (rounded-app border, the
                 top-[calc(100%+.4rem)] gap, the shadow) the way every
                 other picker in this app already does (place picker,
                 discipline picker, header menu -- client/modal-utils.js's
                 createDisclosure). -->
            <div class="relative flex-1 min-w-0" id="grade-value-wrap">
              <button type="button" class="grade-select w-full py-[.65rem]" id="grade-value-btn" aria-haspopup="listbox" aria-expanded="false"></button>
              <div class="absolute top-[calc(100%+.4rem)] left-0 z-20 bg-background border border-border rounded-app p-[.35rem] min-w-full w-max max-w-[calc(100vw-2rem)] shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="grade-value-popover" role="listbox" aria-label="Grade" hidden>
                <ul class="max-h-[13rem] overflow-y-auto m-0 p-0 list-none" id="grade-value-listbox"></ul>
              </div>
            </div>
            <button type="button" class="flex-[0_0_2.6rem] flex items-center justify-center border border-border rounded-app bg-surface text-foreground cursor-pointer hover:border-accent active:scale-[.94]" id="grade-next" aria-label="Next grade">
              <svg class="w-[.8rem] h-[.8rem] fill-current" viewBox="0 0 24 24"><polygon points="8 5 18 12 8 19"></polygon></svg>
            </button>
            <!-- structured number/letter/modifier input, shown instead of
                 the prev/value/next group above when a Non-standard scale
                 is chosen (real Font/French guidebooks use letters/
                 modifiers inconsistently, so this covers the full
                 combinatorial space rather than a flat list --
                 shared/grade-data.js's nonStandardOrdinal). Hidden by
                 default; client/entry-form.js toggles which group shows
                 based on the chosen scale. -->
            <div class="flex flex-1 min-w-0 gap-2" id="grade-ns-fields" hidden>
              <div class="relative flex-1 min-w-[2.6rem]" id="grade-ns-number-wrap">
                <button type="button" class="grade-select w-full py-[.65rem]" id="grade-ns-number-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Grade number"></button>
                <!-- min-w-[3.5rem] (56px) was too narrow once the row's
                     own padding/gap/checkmark are accounted for -- the
                     checkmark SVG has no explicit width of its own
                     (only a min-h/w from renderOptionList's own utility
                     classes), so a cramped popover collapsed it to 0
                     visible width instead of clipping the text. Same
                     5rem floor as the letter/modifier popovers below,
                     for the same reason (Raven, 2026-09-12). -->
                <div class="absolute top-[calc(100%+.4rem)] left-0 z-20 bg-background border border-border rounded-app p-[.35rem] w-full min-w-[5rem] shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="grade-ns-number-popover" role="listbox" aria-label="Grade number" hidden>
                  <ul class="max-h-[10rem] overflow-y-auto m-0 p-0 list-none" id="grade-ns-number-listbox"></ul>
                </div>
              </div>
              <div class="relative flex-[0_0_3.2rem]" id="grade-ns-letter-wrap">
                <button type="button" class="grade-select w-full py-[.65rem]" id="grade-ns-letter-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Grade letter"></button>
                <!-- w-16 (64px) was too narrow once "n/a" (Raven,
                     2026-09-12, replacing the old "–") is the widest
                     option label -- same collapsed-checkmark issue as
                     the number popover above, fixed the same way. -->
                <div class="absolute top-[calc(100%+.4rem)] left-0 z-20 bg-background border border-border rounded-app p-[.35rem] w-20 shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="grade-ns-letter-popover" role="listbox" aria-label="Grade letter" hidden>
                  <ul class="m-0 p-0 list-none" id="grade-ns-letter-listbox"></ul>
                </div>
              </div>
              <div class="relative flex-[0_0_3.2rem]" id="grade-ns-modifier-wrap">
                <button type="button" class="grade-select w-full py-[.65rem]" id="grade-ns-modifier-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Grade modifier"></button>
                <!-- w-16 -> w-20, same reason as the letter popover above. -->
                <div class="absolute top-[calc(100%+.4rem)] left-0 z-20 bg-background border border-border rounded-app p-[.35rem] w-20 shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="grade-ns-modifier-popover" role="listbox" aria-label="Grade modifier" hidden>
                  <ul class="m-0 p-0 list-none" id="grade-ns-modifier-listbox"></ul>
                </div>
              </div>
            </div>
            <div class="relative flex-[0_0_2.6rem]" id="grade-scale-wrap">
              <button type="button" class="w-full h-full flex items-center justify-center border border-border rounded-app bg-surface text-foreground cursor-pointer hover:border-accent active:scale-[.94]" id="grade-scale-btn" aria-haspopup="listbox" aria-expanded="false" aria-label="Change grade scale">
                <!-- Raven, 2026-09-12: "ruler-dimension-line" (Lucide) --
                     reads as "measure/convert this grade" more directly
                     than the old swap-arrows glyph. -->
                <svg class="w-[1.05rem] h-[1.05rem] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 15v-3"></path><path d="M14 15v-3"></path><path d="M18 15v-3"></path><path d="M2 8V4"></path><path d="M22 6H2"></path><path d="M22 8V4"></path><path d="M6 15v-3"></path><rect x="2" y="12" width="20" height="8" rx="2"></rect></svg>
              </button>
              <div class="absolute top-[calc(100%+.4rem)] right-0 z-20 bg-background border border-border rounded-app p-[.35rem] w-56 max-w-[calc(100vw-2rem)] shadow-[0_8px_24px_color-mix(in_srgb,black_35%,transparent)]" id="grade-scale-popover" role="listbox" aria-label="Grade scale" hidden>
                <ul class="m-0 p-0 list-none" id="grade-scale-listbox"></ul>
                <!-- #705 -- href set client-side in client/log-main.js once
                     USERNAME is known, same pattern as #back-to-performance-
                     link on every Performance Insights page. Gated by
                     Athlete Mode like the reference page itself is -- a
                     visitor without it on lands on /log after following
                     this, the same redirect any other /performance/* link
                     would give them. -->
                <a class="block text-[.72rem] text-accent text-center pt-[.4rem] mt-[.2rem] border-t border-border hover:brightness-90" id="grade-scale-reference-link" href="#">What's this?</a>
              </div>
            </div>
          </div>
        </div>
        <div class="flex-[0_1_10.5rem] min-w-[9rem]">
          <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2">Date</div>
          <div class="flex items-stretch gap-2">
            <input type="text" class="text-input flex-1 min-w-0" id="entry-date">
            <!-- #703-review -- a real month-grid popover, same button+
                 popover convention as every other picker in this app
                 (createDisclosure, rounded-app border, the
                 top-[calc(100%+.4rem)] gap, the shadow), replacing the
                 native <input type="date"> + showPicker() this used
                 before -- that native picker panel is OS/browser chrome,
                 unstylable, the exact class of problem this whole
                 button+popover pattern exists to solve. Only ever needs to
                 produce a full YYYY-MM-DD (a calendar day grid has no way
                 to represent "just a month"), same real limit the native
                 date input already had -- the free-text field above is
                 still how a YYYY-MM-only date gets entered.
                 #736 -- markup is rendered by client/calendar-date-
                 picker.js (calendarDatePickerHtml("date-picker")) rather
                 than hand-authored here, so client/time-window.js's own
                 Custom-range date pickers can share the exact same
                 markup+behavior instead of a second hand-rolled copy.
                 Same ids as before (idPrefix "date-picker"), so nothing
                 downstream (e2e/log-page.spec.js's own #date-picker-*
                 assertions) needed to change. This is a plain mount
                 point, not itself "the wrap" -- calendarDatePickerHtml
                 already generates its own id="date-picker-wrap" element
                 with its own layout classes; giving this anchor the same
                 id would nest two elements sharing one id.
                 #790 -- flex-[0_0_2.75rem] IS needed here, though,
                 despite the injected #date-picker-wrap carrying the
                 identical class itself: THIS mount div, not the wrap it
                 injects one level deeper, is the real direct child of
                 the Date field's own "flex items-stretch gap-2" row
                 (the free-text input's sibling) -- a flex-basis/
                 flex-shrink class on a non-flex-item child is simply
                 inert. Without it, this mount had no sizing of its own
                 at all and collapsed to shrink-wrap its button's own
                 icon content (measured ~19px, barely bigger than the
                 icon itself -- exactly the "tiny calendar icon" report,
                 which was really an undersized button, not an
                 undersized icon) instead of matching the Grade row's
                 own #grade-scale-wrap sibling's real 2.6rem square.
                 Also flex (align-items defaults to stretch) so the
                 injected #date-picker-wrap -- itself just a plain block
                 with no height of its own -- fills this mount's now-
                 correct height too, rather than shrinking to its
                 button's own intrinsic content height. -->
            <div class="flex-[0_0_2.75rem] flex" id="date-picker-mount"></div>
          </div>
          <div class="text-[.75rem] text-muted mt-[.3rem]">YYYY-MM or YYYY-MM-DD</div>
        </div>
      </div>

      <!-- #643 -- Lead/Top-Rope, shown only for a Sport entry (client/
           entry-form.js's updateSportStyleVisibility()) -- hidden by
           default here so it never flashes visible before the form's own
           JS runs. -->
      <div class="mt-[1.1rem]" id="sport-style-field" hidden>
        <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2" id="sport-style-label">Style</div>
        <fieldset class="border border-border rounded-app overflow-x-auto flex flex-nowrap w-full mb-3 min-w-0" id="sport-style-group" aria-labelledby="sport-style-label">
          <label class="toggle-btn bg-surface text-muted text-[.85rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex items-center justify-center px-[.3rem] py-[.65rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
            <input type="radio" name="sport-style" value="lead" class="sr-only">
            Lead
          </label>
          <label class="toggle-btn bg-surface text-muted text-[.85rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex items-center justify-center px-[.3rem] py-[.65rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
            <input type="radio" name="sport-style" value="top_rope" class="sr-only">
            Top Rope
          </label>
        </fieldset>
      </div>

      <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2 mt-[1.1rem]" id="status-group-label">Status</div>
      <fieldset class="border border-border rounded-app overflow-x-auto flex flex-nowrap w-full mb-3 min-w-0" id="status-group" aria-labelledby="status-group-label">
        <label class="toggle-btn bg-surface text-muted text-[.78rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex flex-col items-center justify-center gap-[.15rem] px-[.3rem] py-[.45rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
          <input type="radio" name="entry-status" value="flash" class="sr-only">
          <span class="flex [&>svg]:w-6 [&>svg]:h-6" data-icon="flash"></span><span class="text-[.58rem] font-bold uppercase tracking-[.03em]" id="form-flash-label">Flash</span>
        </label>
        <label class="toggle-btn bg-surface text-muted text-[.78rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex flex-col items-center justify-center gap-[.15rem] px-[.3rem] py-[.45rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
          <input type="radio" name="entry-status" value="send" class="sr-only" checked>
          <span class="flex [&>svg]:w-6 [&>svg]:h-6" data-icon="send"></span><span class="text-[.58rem] font-bold uppercase tracking-[.03em]" id="form-send-label">Send</span>
        </label>
        <label class="toggle-btn bg-surface text-muted text-[.78rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex flex-col items-center justify-center gap-[.15rem] px-[.3rem] py-[.45rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
          <input type="radio" name="entry-status" value="project" class="sr-only">
          <span class="flex [&>svg]:w-6 [&>svg]:h-6" data-icon="project"></span><span class="text-[.58rem] font-bold uppercase tracking-[.03em]">Project</span>
        </label>
        <label class="toggle-btn bg-surface text-muted text-[.78rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex flex-col items-center justify-center gap-[.15rem] px-[.3rem] py-[.45rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
          <input type="radio" name="entry-status" value="checkout" class="sr-only">
          <span class="flex [&>svg]:w-6 [&>svg]:h-6" data-icon="checkout"></span><span class="text-[.58rem] font-bold uppercase tracking-[.03em]">Check out</span>
        </label>
        <label class="toggle-btn bg-surface text-muted text-[.78rem] font-semibold cursor-pointer whitespace-nowrap transition-colors duration-150 hover:text-foreground has-checked:bg-accent has-checked:text-accent-foreground has-focus-visible:outline has-focus-visible:outline-2 has-focus-visible:outline-foreground has-focus-visible:outline-offset-[-2px] flex-1 min-w-[4.5rem] flex flex-col items-center justify-center gap-[.15rem] px-[.3rem] py-[.45rem] first:rounded-l-app last:rounded-r-app shadow-[inset_-1px_0_0_var(--color-border)] last:shadow-none">
          <input type="radio" name="entry-status" value="archived" class="sr-only">
          <span class="flex [&>svg]:w-6 [&>svg]:h-6" data-icon="archived"></span><span class="text-[.58rem] font-bold uppercase tracking-[.03em]">Archived</span>
        </label>
      </fieldset>

      <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2 mt-[1.1rem]">Notes</div>
      <div class="mb-3">
        <textarea class="bg-surface border border-border rounded-app px-[.85rem] py-[.65rem] text-foreground font-sans text-[1rem] outline-none focus:border-accent w-full resize-y min-h-[72px]" id="entry-notes"></textarea>
      </div>

      <div class="text-[.72rem] font-semibold uppercase tracking-[.07em] text-muted mb-2 mt-[1.1rem]">Video URL</div>
      <div class="mb-3">
        <input type="url" class="text-input w-full" id="entry-video">
      </div>

      <!-- #791 -- hidden entirely (not just inert) for a logbook-only
           user -- entry-form.js's own open().
           whitespace-nowrap + max-[400px]:text-[.85rem] -- these two
           buttons split the modal's own content width (max-w-[460px]
           minus p-5 padding) in half, and at 1rem/bold, "Performance →"
           wrapped onto two lines at narrow phone widths (a real report,
           not a guess) -- same max-[400px] breakpoint convention
           climbing-header.js's own brand title uses for the identical
           "shrink the text at the narrowest realistic widths" reason. -->
      <div class="flex items-center justify-between gap-3 mt-4">
        <button type="submit" class="flex-1 bg-accent text-accent-foreground border-none rounded-app py-[.9rem] text-[1rem] max-[400px]:text-[.85rem] font-bold cursor-pointer whitespace-nowrap disabled:opacity-[.45] disabled:cursor-not-allowed" id="entry-submit-btn">Save &amp; close</button>
        <button type="button" class="flex-1 bg-surface text-foreground border border-border rounded-app py-[.9rem] text-[1rem] max-[400px]:text-[.85rem] font-bold cursor-pointer whitespace-nowrap hover:border-accent" id="entry-nav-forward">Performance →</button>
      </div>
      </div>

      <!-- #791 -- was a collapsible <details id="performance-insights-
           section">; the page split itself now supersedes needing a
           second, in-page collapse -- see #792 (parked) for whether
           these sub-sections should become individually collapsible
           again, with that state persisted, a separate decision from
           this one. Athlete Mode only -- entry-form.js's own open()
           hides #entry-nav-forward (the only way to reach this page) for
           a logbook-only user, so this content is never shown, but it
           stays in the DOM (not removed) since the same underlying
           fields/values are still part of every submitted entry either
           way (always their default/empty state for a user who never
           reaches this page). -->
      <div class="w-full shrink-0" id="entry-page-2" tabindex="-1">
        <div class="mt-2" id="exertion-field" hidden>
          <h3 class="text-[.95rem] font-bold text-foreground mb-1" id="exertion-field-label">Exertion</h3>
          <p class="text-[.75rem] text-muted mb-2">Feeds your Effort / RPE Trend view.</p>
          <input type="range" class="w-full accent-accent" id="exertion-slider" min="0" max="100" step="10" value="0" aria-labelledby="exertion-field-label" aria-describedby="exertion-value">
          <div class="text-center text-[.85rem] text-foreground mt-1" id="exertion-value">Not set</div>
        </div>

        <div class="mt-6">
          <h3 class="text-[.95rem] font-bold text-foreground mb-1">Attempts</h3>
          <!-- #738 -- was hardcoded to sport's own onsight/redpoint
               wording regardless of which discipline is actually
               active; text set dynamically by entry-form.js's
               updateFormStatusLabels() (same discipline-aware
               flashLabel()/sendLabel() helpers the Flash/Send status
               buttons above already use), matching boulder's own
               flash/send wording here as the static fallback. -->
          <p class="text-[.75rem] text-muted mb-2" id="attempts-gap-hint">Feeds your flash/send gap view.</p>
          <div class="flex items-center justify-start gap-3">
            <button type="button" class="flex-[0_0_var(--field-h)] h-[var(--field-h)] flex items-center justify-center border border-border rounded-app bg-surface text-foreground text-[1.2rem] cursor-pointer hover:border-accent active:scale-[.94] disabled:opacity-[.45] disabled:cursor-not-allowed" id="attempts-minus" aria-label="Decrease attempts">−</button>
            <!-- #597 -- no `pattern` attribute: the displayed value is "–"
                 at 0 (see client/entry-form.js's renderAttempts()), which
                 doesn't match a digits-only pattern -- the browser's own
                 native constraint validation would silently block form
                 submission whenever attempts is unset. inputmode alone
                 still gets the numeric keyboard on mobile; digit-only
                 sanitization happens in JS on every keystroke instead. -->
            <input type="text" inputmode="numeric" class="w-[3ch] text-center font-bold text-[1.1rem] bg-transparent border-none text-foreground outline-none" id="attempts-count" aria-label="Attempts" value="–">
            <button type="button" class="flex-[0_0_var(--field-h)] h-[var(--field-h)] flex items-center justify-center border border-border rounded-app bg-surface text-foreground text-[1.2rem] cursor-pointer hover:border-accent active:scale-[.94]" id="attempts-plus" aria-label="Increase attempts">+</button>
          </div>
        </div>

        <div class="mt-6">
          <h3 class="text-[.95rem] font-bold text-foreground mb-1">Move difficulty</h3>
          <p class="text-[.75rem] text-muted mb-2">Feeds your Strengths / Weaknesses view.</p>
          <div class="text-[.8rem] font-semibold text-foreground mb-1">Hardest moves for you</div>
          <div id="hardest-moves-list"></div>
          <button type="button" class="text-[.85rem] font-semibold text-accent bg-transparent border-0 cursor-pointer p-0 mb-2" id="hardest-moves-add" aria-label="Add a hardest move">+ Add a move</button>

          <div class="text-[.8rem] font-semibold text-foreground mb-1 mt-2">Easiest moves for you</div>
          <div id="easiest-moves-list"></div>
          <button type="button" class="text-[.85rem] font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" id="easiest-moves-add" aria-label="Add an easiest move">+ Add a move</button>
        </div>

        <div class="mt-6">
          <h3 class="text-[.95rem] font-bold text-foreground mb-1">Pain/injury during this climb</h3>
          <p class="text-[.75rem] text-muted mb-2">Feeds your Injury / Pain Log.</p>
          <div id="pain-moves-list"></div>
          <button type="button" class="text-[.85rem] font-semibold text-accent bg-transparent border-0 cursor-pointer p-0" id="pain-moves-add" aria-label="Add a pain/injury move">+ Add a move</button>
        </div>

        <!-- #791 -- same whitespace-nowrap + max-[400px]:text-[.85rem]
             as page 1's own button row, for the identical reason. -->
        <div class="flex items-center justify-between gap-3 mt-6">
          <button type="button" class="flex-1 bg-surface text-foreground border border-border rounded-app py-[.9rem] text-[1rem] max-[400px]:text-[.85rem] font-bold cursor-pointer whitespace-nowrap hover:border-accent" id="entry-nav-back">← Log entry</button>
          <button type="submit" class="flex-1 bg-accent text-accent-foreground border-none rounded-app py-[.9rem] text-[1rem] max-[400px]:text-[.85rem] font-bold cursor-pointer whitespace-nowrap disabled:opacity-[.45] disabled:cursor-not-allowed" id="entry-submit-btn-2">Save &amp; close</button>
        </div>
      </div>
      </div>
    </div>

      <button type="button" class="w-full mt-[.6rem] bg-transparent text-red-400 border border-red-400/40 rounded-app py-[.7rem] text-[.9rem] font-semibold cursor-pointer hover:bg-red-400/10 disabled:opacity-[.45] disabled:cursor-not-allowed" id="entry-delete-btn" hidden>Delete entry</button>
      <div class="hidden" id="entry-msg" role="alert" aria-live="assertive" tabindex="-1"></div>
    </form>
  </div>
</div>

