---
layout: admin-layout.njk
title: Admin – Climbing Logbook
bundle: admin
---
{% set tabClass = "pb-2 text-muted no-underline aria-[current=page]:text-foreground aria-[current=page]:border-b-2 aria-[current=page]:border-accent" %}
{% set backIcon %}<svg class="w-[.9rem] h-[.9rem] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>{% endset %}
{% set detailClass = "flex-[999_1_480px] min-w-0 flex flex-col gap-4 min-[900px]:p-5 min-[900px]:bg-surface min-[900px]:border min-[900px]:border-border min-[900px]:rounded-app" %}
<nav class="flex flex-wrap gap-x-5 gap-y-1 mt-4 text-[.95rem] max-[480px]:gap-x-3.5 max-[480px]:text-sm font-semibold border-b border-border" aria-label="Admin">
  <a class="{{ tabClass }}" id="tab-reports" href="/reports">Reports <span class="text-accent-ink" data-unread></span></a>
  <a class="{{ tabClass }}" id="tab-feedback" href="/feedback">Feedback <span class="text-accent-ink" data-unread></span></a>
  <a class="{{ tabClass }}" id="tab-users" href="/users">Users</a>
  <a class="{{ tabClass }}" id="tab-usage" href="/usage">Usage</a>
  <a class="{{ tabClass }}" id="tab-activity" href="/activity">Activity</a>
</nav>

<section id="submissions-view" aria-label="Submissions" hidden>
  <div class="flex mt-4 w-fit border border-border rounded-app overflow-hidden text-sm font-semibold" role="group" aria-label="Show">
    <button type="button" class="px-3.5 py-1.5 text-muted bg-transparent border-0 cursor-pointer aria-pressed:bg-surface aria-pressed:text-foreground" id="show-active">Active</button>
    <button type="button" class="px-3.5 py-1.5 text-muted bg-transparent border-0 border-l border-border cursor-pointer aria-pressed:bg-surface aria-pressed:text-foreground" id="show-archived">Archived</button>
  </div>

  <div class="flex flex-wrap gap-6 mt-4 items-start">
    <div class="flex-[1_1_360px] max-w-[440px] min-w-0" id="list-pane">
      <p class="text-sm text-muted" id="list-status" role="status"></p>
      <ul class="list-none flex flex-col gap-2" id="submission-list"></ul>
    </div>

    <article class="{{ detailClass }}" id="detail-pane" aria-labelledby="detail-heading" hidden>
      <a class="back-link self-start min-[900px]:hidden" id="detail-back" href="#">{{ backIcon | safe }}<span id="detail-back-label"></span></a>
      <h2 class="sr-only" id="detail-heading"></h2>
      <p class="text-[.95rem] leading-relaxed whitespace-pre-wrap break-words max-w-[65ch]" id="detail-message"></p>
      <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm" id="detail-fields"></dl>
      <div class="flex flex-wrap gap-2">
        <button type="button" class="btn" id="toggle-read"></button>
        <button type="button" class="btn" id="toggle-archived"></button>
        <button type="button" class="btn ml-auto text-accent-ink border-accent" id="delete-btn">Delete</button>
      </div>
      <p class="error-message" id="detail-error" role="alert" hidden></p>
    </article>
  </div>

  <dialog class="m-auto w-[calc(100%-2rem)] max-w-[24rem] p-5 bg-background text-foreground border border-border rounded-app backdrop:bg-[color-mix(in_srgb,black_60%,transparent)]" id="delete-dialog" aria-labelledby="delete-title">
    <form class="flex flex-col gap-3" method="dialog">
      <h2 class="text-lg font-bold" id="delete-title"></h2>
      <p class="text-sm text-muted">It's removed for good. Archive it instead if you might want it again.</p>
      <div class="flex justify-end gap-2 pt-1">
        <button type="submit" class="btn" value="cancel" autofocus>Cancel</button>
        <button type="submit" class="btn btn-primary" value="delete">Delete</button>
      </div>
    </form>
  </dialog>
</section>

<section id="users-view" aria-label="Users" hidden>
  <label class="block mt-4 max-w-[440px]">
    <span class="sr-only">Search by username or email</span>
    <input class="text-input w-full" id="user-search" type="search" placeholder="Search by username or email" autocomplete="off">
  </label>

  <div class="flex flex-wrap gap-6 mt-4 items-start">
    <div class="flex-[1_1_360px] max-w-[440px] min-w-0" id="user-list-pane">
      <p class="text-sm text-muted" id="user-status" role="status"></p>
      <ul class="list-none flex flex-col gap-2" id="user-list"></ul>
    </div>

    <article class="{{ detailClass }}" id="user-detail" aria-labelledby="user-heading" hidden>
      <a class="back-link self-start min-[900px]:hidden" id="user-back" href="/users">{{ backIcon | safe }}Users</a>
      <h2 class="text-lg font-bold break-all" id="user-heading"></h2>
      <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 text-sm" id="user-fields"></dl>
      <div class="flex flex-wrap gap-2" id="user-actions">
        <button type="button" class="btn" id="toggle-suspend"></button>
        <button type="button" class="btn ml-auto text-accent-ink border-accent" id="user-delete">Delete</button>
        <button type="button" class="btn text-accent-ink border-accent" id="user-ban">Ban</button>
      </div>
      <p class="text-sm text-muted" id="user-demo-note" hidden>A demo account. It can't be changed here.</p>
      <p class="error-message" id="user-error" role="alert" hidden></p>
    </article>
  </div>

  <dialog class="m-auto w-[calc(100%-2rem)] max-w-[26rem] p-5 bg-background text-foreground border border-border rounded-app backdrop:bg-[color-mix(in_srgb,black_60%,transparent)]" id="user-dialog" aria-labelledby="user-dialog-title">
    <form class="flex flex-col gap-3" method="dialog">
      <h2 class="text-lg font-bold break-all" id="user-dialog-title"></h2>
      <p class="text-sm text-muted" id="user-dialog-text"></p>
      <label class="flex flex-col gap-1 text-sm font-semibold">
        Type their username to confirm
        <input class="text-input" id="user-confirm" type="text" autocomplete="off" autocapitalize="none" spellcheck="false">
      </label>
      <div class="flex justify-end gap-2 pt-1">
        <button type="submit" class="btn" value="cancel">Cancel</button>
        <button type="submit" class="btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed" value="confirm" id="user-dialog-confirm" disabled></button>
      </div>
    </form>
  </dialog>
</section>

<section id="usage-view" aria-label="Usage" hidden>
  <p class="mt-3 text-xs min-[900px]:text-sm text-muted">Real accounts only: the demo accounts aren't counted.</p>
  <p class="mt-3 text-sm text-muted" id="usage-status" role="status"></p>
  <div class="flex flex-col gap-6 mt-3" id="usage-body" hidden>
    <div class="grid grid-cols-2 min-[900px]:grid-cols-4 gap-2 min-[900px]:gap-3" id="usage-tiles"></div>
    <div class="flex flex-wrap gap-6 items-start">
      <div class="flex-[1_1_360px] min-w-0 flex flex-col gap-6">
        <section class="flex flex-col gap-3" aria-labelledby="usage-people-heading">
          <h2 class="text-[.95rem] font-bold" id="usage-people-heading">People</h2>
          <div class="flex flex-col gap-3" id="usage-people"></div>
        </section>
        <section class="flex flex-col gap-3" aria-labelledby="usage-climbs-heading">
          <h2 class="text-[.95rem] font-bold" id="usage-climbs-heading">Climbs</h2>
          <div class="flex flex-col gap-1.5" id="usage-disciplines"></div>
          <div class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-2 text-sm" id="usage-statuses"></div>
        </section>
      </div>
      <section class="flex-[1_1_480px] min-w-0 flex flex-col gap-2" aria-labelledby="usage-places-heading">
        <h2 class="text-[.95rem] font-bold" id="usage-places-heading">Places by country</h2>
        <table class="w-full border-collapse text-sm tabular-nums">
          <thead>
            <tr class="text-left text-muted"><th class="py-1.5 font-semibold" scope="col">Country</th><th class="font-semibold text-right" scope="col">Places</th><th class="font-semibold text-right" scope="col">Climbs</th></tr>
          </thead>
          <tbody id="usage-countries"></tbody>
        </table>
        <p class="text-sm text-muted" id="usage-countries-empty" hidden>No places yet.</p>
      </section>
    </div>
  </div>
</section>

<section id="activity-view" aria-labelledby="activity-heading" hidden>
  <h2 class="sr-only" id="activity-heading">Activity</h2>
  <p class="mt-4 text-sm text-muted" id="activity-status" role="status"></p>
  <ul class="list-none max-w-[720px]" id="activity-list"></ul>
</section>
