---
layout: app-layout.njk
title: My account – Climbing Logbook
bundle: account
staticShellNote: |-
  Genuinely static shell (#348), same pattern as public/log/index.html
         -- see that file's own comment for why every path below is absolute
         and client/account-main.js reads the username from
         location.pathname itself rather than this file being templated.
headerClass: mb-6
---
<div class="max-w-[960px] mx-auto">
  <a class="back-link mt-4 mb-5" id="back-to-logbook-link" href="#">
    <svg class="w-[.9rem] h-[.9rem] stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
    My Climbing Logbook
  </a>

  <div class="grid grid-cols-2 gap-x-8 max-[600px]:grid-cols-1" id="account-sections">
    <div>
      <h1 class="card-section-heading">My account</h1>
      <div class="flex flex-col gap-2 max-w-[420px]" id="account-options">
        <a class="row-card flex items-center justify-between row-card-title hover:border-accent" id="edit-account-link" href="#">
          Edit account details
          <svg class="w-4 h-4 stroke-muted fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
        <div class="row-card flex items-center justify-between row-card-title text-muted">
          Display preferences
          <span class="text-xs text-muted font-semibold">Coming soon</span>
        </div>
        <a class="row-card flex items-center justify-between row-card-title hover:border-accent" id="import-link" href="#">
          Import entries
          <svg class="w-4 h-4 stroke-muted fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
        <div class="row-card flex items-center justify-between row-card-title">
          Export entries
          <div class="flex gap-2">
            <button type="button" class="btn" id="export-csv-btn">CSV</button>
            <button type="button" class="btn" id="export-json-btn">JSON</button>
          </div>
        </div>
        <p class="text-sm text-accent-ink" id="export-error" hidden></p>
        <div class="row-card" id="remove-data-row" hidden>
          <span class="row-card-title">Clear my data from this device</span>
          <p class="text-sm text-muted mt-2" id="remove-data-description">Nothing is deleted from your account. Your logbook is taken off this device and you're logged out, and it all syncs back the next time you log in here.</p>
          <div class="flex gap-2 mt-3 p-3 rounded-app border border-warning-border bg-warning-bg text-sm text-warning-ink" id="remove-data-warning" role="status" hidden>
            <svg class="w-4 h-4 mt-[.15rem] shrink-0 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg>
            <p><span id="remove-data-warning-text"></span> <a class="underline" id="remove-data-log-link" href="#">Check on your log.</a></p>
          </div>
          <button type="button" class="btn btn-primary mt-3" id="remove-data-btn" aria-describedby="remove-data-description">Clear device data</button>
          <p class="text-sm text-accent-ink mt-3" id="remove-data-error" role="alert" hidden></p>
        </div>
      </div>
    </div>

    <div class="max-[600px]:mt-8">
      <h2 class="card-section-heading">Settings</h2>
      <div class="flex flex-col gap-2 max-w-[420px]" id="account-settings">
        <div class="row-card flex items-center gap-3" id="athlete-mode-row" hidden>
          <div class="flex-1 min-w-0">
            <span class="row-card-title" id="athlete-mode-title">Athlete Mode</span>
            <p class="text-sm text-muted mt-2" id="athlete-mode-description">Unlocks performance insights on your Performance page, visible only to you.</p>
          </div>
          <button type="button" class="group inline-flex items-center bg-transparent border border-transparent cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed shrink-0" id="athlete-mode-toggle" aria-labelledby="athlete-mode-title" aria-describedby="athlete-mode-description" role="switch" aria-checked="false">
            <span class="switch-track group-aria-checked:switch-track-on"><span class="switch-thumb group-aria-checked:switch-thumb-on"></span></span>
          </button>
        </div>
        <div class="row-card flex items-center gap-3" id="public-logbook-row" hidden>
          <div class="flex-1 min-w-0">
            <span class="row-card-title" id="public-logbook-title">Public Logbook</span>
            <p class="text-sm text-muted mt-2" id="public-logbook-description">When on, anyone can view your logbook and map at your public profile page. Turn off to keep them private -- only you can see them.</p>
          </div>
          <button type="button" class="group inline-flex items-center bg-transparent border border-transparent cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed shrink-0" id="public-logbook-toggle" aria-labelledby="public-logbook-title" aria-describedby="public-logbook-description" role="switch" aria-checked="true">
            <span class="switch-track group-aria-checked:switch-track-on"><span class="switch-thumb group-aria-checked:switch-thumb-on"></span></span>
          </button>
        </div>
        <a class="row-card flex items-center gap-3 hover:border-accent" id="beta-row" href="#" hidden>
          <div class="flex-1 min-w-0">
            <span class="row-card-title">Check our beta</span>
            <p class="text-sm text-muted mt-2">Get early access to new features before they're released.</p>
            <p class="text-sm text-accent-ink mt-1" id="beta-status"></p>
          </div>
          <svg class="w-4 h-4 stroke-muted fill-none shrink-0" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
        </a>
      </div>
    </div>
  </div>

</div>
