node_modules/
.wrangler/
.dev.vars
.env
.wrangler-dev.log

# JetBrains IDE (WebStorm/IntelliJ/etc.) project config -- personal, no
# shared value, same reasoning as any other IDE-state directory
.idea/

# Claude Code config: settings.json (shared hooks/permissions), launch.json
# (dev-server config for the preview tools), and skills/ (shared engineering
# process docs, see .claude/skills/engineering-standards/) are checked in
# deliberately -- they're team/repo-level resources, not personal state.
# settings.local.json stays ignored: it's per-machine accumulated permission
# grants (Claude Code's own convention for the "local" suffix), genuinely
# personal, no shared value.
.claude/*
!.claude/settings.json
!.claude/launch.json
!.claude/skills/

# public/ (#877) -- 100% generated: 11ty's own page-shell HTML output
# (`html:build`/`html:watch` from views/*.njk), the static/ assets it
# passes through unchanged (icons, manifest, service worker, custom-
# element components, world maps, _headers, the auth-shell pages' own
# scripts -- see .eleventy.js's addPassthroughCopy), Tailwind's built
# CSS (`tailwind:build`/`tailwind:watch`), and Pagefind's /help search
# index (.eleventy.js's eleventy.after hook). Nothing under public/ is
# committed -- the directory is safe to delete and regenerate from
# nothing at any time.
public/

# Production/preview/beta build output (#774, #761 Part 2) -- `pnpm run
# deploy:build`/`pnpm run preview` (vite build/vite preview,
# vite.deploy.config.js) write both the Worker script and the client
# assets here (dist/climbing_logbook/, dist/client/) -- the client
# assets include every client/*-main.js entry (previously 16 separate
# hand-rolled esbuild bundles landing directly in public/logbook/,
# before #761/#774; there is no longer any build that writes JS bundles
# into public/ at all -- public/logbook/app.js, the retired /logbook
# page's own old bundle target, #375, is correspondingly also dead).
# `wrangler deploy`/`wrangler versions upload` detect the `wrangler.json`
# redirect this writes (`.wrangler/deploy/config.json`, covered by the
# `.wrangler/` entry above already) and deploy straight from here
# instead of bundling anything themselves.
dist/

# Playwright E2E (#218): local report/trace/result output, not source
test-results/
playwright-report/
blob-report/

# Bootstrapped dev-session cookie (#297) -- generated fresh by
# e2e/global-setup.js each run, not a real credential (local-only dev
# user, never a real account), but still runtime state, not source.
e2e/.auth/
playwright/.cache/

# Terraform
infra/.terraform/
infra/terraform.tfvars
infra/*.tfplan
infra/*.tfstate
infra/*.tfstate.*
