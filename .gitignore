node_modules/
.wrangler/
.dev.vars
.env
.wrangler-dev.log

# JetBrains IDE (WebStorm/IntelliJ/etc.) project config -- personal, no
# shared value, same reasoning as any other IDE-state directory
.idea/

# Claude Code config: settings.json (shared hooks/permissions), launch.json
# (dev-server config for the preview tools), and skills/ (shared engineering
# process docs, see .claude/skills/engineering-standards/) are checked in
# deliberately -- they're team/repo-level resources, not personal state.
# settings.local.json stays ignored: it's per-machine accumulated permission
# grants (Claude Code's own convention for the "local" suffix), genuinely
# personal, no shared value.
.claude/*
!.claude/settings.json
!.claude/launch.json
!.claude/skills/

# 11ty page-shell output (#760) -- generated by `pnpm run html:build`/
# `html:watch` from views/*.njk, not committed, same pattern as
# tailwind.css below.
public/index.html
public/login/index.html
public/register/index.html
public/reset-password/index.html
public/log/index.html
public/map/index.html
public/profile/index.html
public/performance/index.html
public/performance/pyramid/index.html
public/performance/trends/index.html
public/performance/gap/index.html
public/performance/rpe/index.html
public/performance/injury/index.html
public/performance/strengths/index.html
public/performance/grades/index.html
public/account/index.html
public/account/edit/index.html
public/account/import/index.html
public/sync/index.html
public/beta-gate/index.html

# Tailwind build output — generated by `pnpm run tailwind:build`/`tailwind:watch`,
# not committed (see package.json scripts and .github/workflows/deploy.yml)
public/logbook/tailwind.css

# Client JS bundle output — generated by `pnpm run client:build` (vite
# build, vite.config.js), not committed, same pattern as tailwind.css
# above. One file per client/*-main.js entry (#761 -- real Rollup
# code-splitting replaced the previous per-page hand-rolled esbuild
# scripts this comment used to list individually), plus shared chunks.
# public/logbook/app.js was the retired /logbook page's own bundle
# (#375) -- dead, no longer generated by anything; removed here rather
# than left as a stale entry.
public/logbook/map-app.js
public/logbook/performance-pyramid-app.js
public/logbook/performance-hub-app.js
public/logbook/performance-injury-app.js
public/logbook/performance-strengths-app.js
public/logbook/performance-trends-app.js
public/logbook/performance-gap-app.js
public/logbook/performance-rpe-app.js
public/logbook/performance-grades-app.js
public/logbook/log-app.js
public/logbook/profile-app.js
public/logbook/account-app.js
public/logbook/account-edit-app.js
public/logbook/account-import-app.js
public/logbook/sync-app.js
public/logbook/beta-gate-app.js
public/logbook/chunks/

# Playwright E2E (#218): local report/trace/result output, not source
test-results/
playwright-report/
blob-report/

# e2e component-harness fixture bundles (#407 Tier 1) -- generated by
# `pnpm run e2e:build-fixtures` (esbuild, from e2e/fixtures/*-entry.js)
# into public/e2e-fixtures/, same "gitignored build output, rebuilt by
# Playwright's own webServer command" pattern as the real page bundles
# above. Deliberately never part of `pnpm run deploy`'s own build list
# (see that command's own comment) -- a clean production checkout never
# has this directory populated at all, so it's never uploaded as a real
# asset regardless of the routing gate #407 itself added.
public/e2e-fixtures/

# Bootstrapped dev-session cookie (#297) -- generated fresh by
# e2e/global-setup.js each run, not a real credential (local-only dev
# user, never a real account), but still runtime state, not source.
e2e/.auth/
playwright/.cache/

# Terraform
infra/.terraform/
infra/terraform.tfvars
infra/*.tfplan
infra/*.tfstate
infra/*.tfstate.*
