{
  "name": "climbing-logbook",
  "version": "0.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "concurrently -n vite,tailwind,html -c blue,magenta,green \"vite dev\" \"tailwindcss -i ./styles/tailwind.css -o ./public-dev/-/tailwind.css --watch\" \"pnpm run html:watch\"",
    "html:build": "node scripts/clean-dir.mjs public && eleventy",
    "html:watch": "eleventy --watch --output=public-dev",
    "tailwind:build": "tailwindcss -i ./styles/tailwind.css -o ./public/-/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./styles/tailwind.css -o ./public-dev/-/tailwind.css --watch",
    "deploy:build": "node scripts/require-cloudflare-env.mjs && vite build --config vite.deploy.config.js",
    "preview": "pnpm run html:build && pnpm run tailwind:build && pnpm run deploy:build && vite preview --config vite.deploy.config.js",
    "seed": "node scripts/seed-dev-data.mjs",
    "seed:demo": "node scripts/seed-demo-accounts.mjs",
    "audit:usernames": "node scripts/audit-usernames.mjs",
    "lint": "biome check --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e-wdio.mjs",
    "e2e:area": "node scripts/e2e-area.mjs",
    "e2e:build-fixtures": "mkdir -p public/e2e-fixtures && cp e2e/fixtures/*.html public/e2e-fixtures/ && esbuild e2e/fixtures/map-harness-entry.js --bundle --format=esm --outfile=public/e2e-fixtures/map-harness.js && esbuild e2e/fixtures/pyramid-harness-entry.js --bundle --format=esm --outfile=public/e2e-fixtures/pyramid-harness.js && esbuild client/components/climbing-grade-pyramid.js --bundle --format=esm --outfile=public/e2e-fixtures/climbing-grade-pyramid.js && esbuild client/components/climbing-entries-table.js --bundle --format=esm --outfile=public/e2e-fixtures/climbing-entries-table.js"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@biomejs/biome": "^2.6.4",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/vitest-plugin": "^1.5.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@tailwindcss/cli": "^4.3.4",
    "@vitest/coverage-v8": "^5.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "@wdio/utils": "10.1.0",
    "axe-core": "^4.14.0",
    "concurrently": "^10.0.6",
    "d3-geo": "^3.1.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.7",
    "fontkit": "2.0.4",
    "happy-dom": "^21.0.4",
    "pagefind": "^1.6.0",
    "semver": "^7.8.6",
    "tailwindcss": "^4.3.4",
    "topojson-client": "^3.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "webdriverio": "10.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "wrangler": "^4.156.2"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.15",
    "@floating-ui/dom": "^1.8.0",
    "@ravendarque/beta-interpreter": "0.2.0",
    "better-auth": "^1.7.15",
    "obscenity": "0.4.6",
    "resend": "^6.37.0",
    "uqr": "0.1.3",
    "valibot": "^1.5.0"
  }
}
