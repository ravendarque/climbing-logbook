{
  "name": "climbing-logbook",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:raw": "concurrently -n wrangler,tailwind -c blue,magenta \"wrangler dev\" \"tailwindcss -i ./styles/tailwind.css -o ./public/logbook/tailwind.css --watch\"",
    "deploy": "pnpm run tailwind:build && wrangler deploy",
    "tailwind:build": "tailwindcss -i ./styles/tailwind.css -o ./public/logbook/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i ./styles/tailwind.css -o ./public/logbook/tailwind.css --watch",
    "seed": "node scripts/seed-dev-data.mjs"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "concurrently": "^10.0.3",
    "d3-geo": "^3.1.1",
    "semver": "^7.8.5",
    "tailwindcss": "^4.3.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6"
  }
}
