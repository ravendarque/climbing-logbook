{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-logbook",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  // Better Auth (#20) depends on Node.js built-ins (e.g. node:crypto) not
  // natively available in the Workers runtime otherwise.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    { "binding": "LOGBOOK_KV", "id": "47bd45146334450f82ca7dcb69c34b15" }
  ],
  // Better Auth (#20) + the eventual multi-tenant app data (#21) -- id is a
  // placeholder until infra/d1.tf's Terraform apply provisions the real
  // database and infra.yml's sync step (same mechanism as the KV id below)
  // rewrites it. Placeholder is harmless for local dev/Vitest -- both run
  // against a local Miniflare-simulated D1, which doesn't need the id to
  // correspond to a real remote database.
  "d1_databases": [
    { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
  ],
  // Beta invite/registration gate (#296) -- not a secret, so `vars` (not
  // `.dev.vars`) is the right place. Flipping this to "false" here is the
  // entire "go fully public" mechanism once the beta period ends (#296) --
  // no code change needed. Explicitly duplicated into env.preview below,
  // not left to inherit -- `vars` is NOT inherited by named environments
  // (confirmed via `wrangler deploy --dry-run`'s own warning, 2026-08-06;
  // a prior version of this comment claimed the opposite, which appears
  // to have meant every PR preview silently ran with BETA_GATE_ENABLED
  // undefined -- falsy, so the gate was never actually enforced there).
  "vars": {
    "BETA_GATE_ENABLED": "true"
  },
  "routes": [
    { "pattern": "ravendarque.com/logbook*", "zone_name": "ravendarque.com" }
  ],
  "observability": {
    "enabled": true
  },
  // PR preview deployments (#222) -- `wrangler versions upload --env preview`
  // in CI (see .github/workflows/preview.yml) uploads a version of a
  // *separate* Worker script (Wrangler appends the environment name --
  // this becomes "climbing-logbook-preview", not "climbing-logbook") bound
  // to its own KV namespace, never the production one. `routes` and
  // `kv_namespaces` are both explicitly overridden rather than left to
  // inherit from the top level -- routes/workers_dev are inheritable by
  // default, and while `versions upload` (unlike `deploy`) never actually
  // attaches a route to traffic, there's no reason to leave the production
  // route pattern sitting in the preview env's config at all.
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      // Same value as the top-level `vars` above, duplicated deliberately
      // -- `vars` is not inherited by named environments (see that
      // block's own comment for how this was discovered).
      "vars": {
        "BETA_GATE_ENABLED": "true"
      },
      "kv_namespaces": [
        { "binding": "LOGBOOK_KV", "id": "c09de14bab5142c58b6cb90b6072ba2f" }
      ],
      // Own D1 database, same disposable-preview-data reasoning as the KV
      // namespace above -- manually bootstrapped (`wrangler d1 create
      // climbing-logbook-preview`), not Terraform-managed, matching the KV
      // precedent. Was previously missing entirely: `d1_databases` isn't
      // inheritable-but-overridden like `vars`/`routes` are documented to
      // be here, it's inheritable-and-left-alone, which silently pointed
      // every PR preview at the *production* database once #21 gave
      // LOGBOOK_DB a real id (harmless placeholder before that; a real
      // shared-data risk after). Caught 2026-08-05 when Raven asked for
      // #320's PR preview login credentials -- there weren't any, and
      // signing up there would have written into production.
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ]
    }
  }
}
