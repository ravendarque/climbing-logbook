{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-logbook",
  // Explicit: account auto-resolution needs a Memberships permission the tokens don't have.
  "account_id": "4f63d74beb21402b8622361525ab4868",
  "main": "server/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Shell paths go through the Worker so a shell is only served after its session check
  // (test/wrangler-run-worker-first.test.js). Everything else is served straight from assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/log", "/log/*",
      "/map", "/map/*",
      "/performance", "/performance/*",
      "/profile", "/profile/*",
      "/account", "/account/*",
      "/sync", "/sync/*",
      "/-/manifest.json", "/-/apple-touch-icon.png"
    ]
  },
  // The id is a placeholder until the Infra workflow writes the real one; keep these three keys adjacent for its regex.
  "d1_databases": [
    { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
  ],
  // Named environments don't inherit vars, so each one repeats them. Rate limiting only on real
  // deployments: elsewhere there's no client IP (docs/app-architecture.md, Better Auth configuration).
  "vars": {
    "BETA_GATE_ENABLED": "true",
    "RATE_LIMITING_ENABLED": "true"
  },
  "routes": [
    { "pattern": "climbinglogbook.com/*", "zone_name": "climbinglogbook.com" },
    { "pattern": "my.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" }
  ],
  "observability": {
    "enabled": true
  },
  // A separate Worker (climbing-logbook-preview) with its own database; routes overridden so nothing attaches.
  "env": {
    // So a typo'd CLOUDFLARE_ENV fails loudly. name is explicit, or Wrangler deploys a second
    // "climbing-logbook-production" script. Infra syncs only the top-level D1 id: update the env copies by hand.
    "production": {
      "name": "climbing-logbook",
      "vars": {
        "BETA_GATE_ENABLED": "true",
        "RATE_LIMITING_ENABLED": "true"
      },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
      ]
    },
    "preview": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "BETA_GATE_ENABLED": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
        "RATE_LIMITING_ENABLED": "true"
      },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ]
    },
    // Like preview, but never deployed, so no rate limiting (no real client IP).
    "e2e": {
      "workers_dev": true,
      "routes": [],
      "vars": {
        "BETA_GATE_ENABLED": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ]
    },
    "beta": {
      "routes": [
        { "pattern": "beta.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" }
      ],
      "vars": {
        "BETA_GATE_ENABLED": "true",
        "RATE_LIMITING_ENABLED": "true"
      },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
      ]
    }
  }
}
