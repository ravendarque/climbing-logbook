{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-logbook",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    { "binding": "LOGBOOK_KV", "id": "47bd45146334450f82ca7dcb69c34b15" }
  ],
  "routes": [
    { "pattern": "ravendarque.com/logbook*", "zone_name": "ravendarque.com" }
  ],
  "observability": {
    "enabled": true
  }
}
