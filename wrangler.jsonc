{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-logbook",
  // Explicit: account auto-resolution needs a Memberships permission the tokens don't have.
  "account_id": "4f63d74beb21402b8622361525ab4868",
  "main": "server/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // Shell paths go through the Worker so a shell is only served after its session check
  // (test/wrangler-run-worker-first.test.js). Everything else is served straight from assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/log", "/log/*",
      "/performance", "/performance/*",
      "/profile", "/profile/*",
      "/account", "/account/*",
      "/sync", "/sync/*",
      "/welcome", "/welcome/*",
      "/view", "/view/*",
      "/", "/admin", "/admin/*", "/-/admin-app.js",
      "/-/manifest.json", "/-/apple-touch-icon.png",
      "/help", "/help/*", "!/help/pagefind/*",
      "/login", "/login/", "/register", "/register/", "/reset-password", "/reset-password/",
      "/-/launch/*"
    ]
  },
  "ratelimits": [
    { "name": "AUTH_RATE_LIMITER", "namespace_id": "1292", "simple": { "limit": 10, "period": 60 } },
    { "name": "WRITE_RATE_LIMITER", "namespace_id": "1045", "simple": { "limit": 120, "period": 60 } },
    { "name": "CSP_REPORT_LIMITER", "namespace_id": "1042", "simple": { "limit": 10, "period": 60 } },

    { "name": "IMPORT_LIMITER", "namespace_id": "10492", "simple": { "limit": 2, "period": 60 } },

    { "name": "SIGN_IN_ACCOUNT_LIMITER", "namespace_id": "10493", "simple": { "limit": 5, "period": 60 } }
  ],
  "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RecipientEmailLimiter"] }],
  // The id is a placeholder until the Infra workflow writes the real one; keep these three keys adjacent for its regex.
  "d1_databases": [
    { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
  ],
  // Named environments don't inherit vars, so each one repeats them. Rate limiting only on real
  // deployments: elsewhere there's no client IP (docs/app-architecture.md, Better Auth configuration).
  // ACCESS_AUD is written by the Infra workflow; until it is, the admin host refuses everything (ADR-0034).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "APP_ENV": "development",
    "BETA_GATE_ENABLED": "true",
    "RATE_LIMITING_ENABLED": "true",
    "ACCESS_TEAM_DOMAIN": "ravendarque.cloudflareaccess.com",
    "ACCESS_AUD": "d63c4a6b2ab69f2f2cc6b3b43e1224a4f5b19a2534156329a52fcbb9177a6f7d"
  },
  "routes": [
    { "pattern": "climbinglogbook.com/*", "zone_name": "climbinglogbook.com" },
    { "pattern": "my.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" },
    { "pattern": "admin.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" }
  ],
  "observability": {
    "enabled": true,
    "issues": { "enabled": true }
  },
  // A separate Worker (climbing-logbook-preview) with its own database; routes overridden so nothing attaches.
  "env": {
    // So a typo'd CLOUDFLARE_ENV fails loudly. name is explicit, or Wrangler deploys a second
    // "climbing-logbook-production" script. Infra syncs only the top-level D1 id: update the env copies by hand.
    "production": {
      "name": "climbing-logbook",
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "production",
        "BETA_GATE_ENABLED": "true",
        "RATE_LIMITING_ENABLED": "true",
        "ACCESS_TEAM_DOMAIN": "ravendarque.cloudflareaccess.com",
        "ACCESS_AUD": "d63c4a6b2ab69f2f2cc6b3b43e1224a4f5b19a2534156329a52fcbb9177a6f7d"
      },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1292", "simple": { "limit": 10, "period": 60 } },
        { "name": "WRITE_RATE_LIMITER", "namespace_id": "1045", "simple": { "limit": 120, "period": 60 } },
        { "name": "CSP_REPORT_LIMITER", "namespace_id": "1042", "simple": { "limit": 10, "period": 60 } },

        { "name": "IMPORT_LIMITER", "namespace_id": "10492", "simple": { "limit": 2, "period": 60 } },

        { "name": "SIGN_IN_ACCOUNT_LIMITER", "namespace_id": "10493", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
      ]
    },
    "preview": {
      "workers_dev": true,
      "routes": [],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "preview",
        "BETA_GATE_ENABLED": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
        "RATE_LIMITING_ENABLED": "true",
        // A preview has one workers.dev host, with no my. to put owner pages on.
        "OWNER_PAGES_ON_ANY_HOST": "true"
      },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1292", "simple": { "limit": 10, "period": 60 } },
        { "name": "WRITE_RATE_LIMITER", "namespace_id": "1045", "simple": { "limit": 120, "period": 60 } },
        { "name": "CSP_REPORT_LIMITER", "namespace_id": "1042", "simple": { "limit": 10, "period": 60 } },

        { "name": "IMPORT_LIMITER", "namespace_id": "10492", "simple": { "limit": 2, "period": 60 } },

        { "name": "SIGN_IN_ACCOUNT_LIMITER", "namespace_id": "10493", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ],
      // Each PR's Preview (#1338) inherits none of the above, so it repeats what the app needs.
      "previews": {
        "version_metadata": { "binding": "CF_VERSION_METADATA" },
        "vars": {
          "APP_ENV": "preview",
          "BETA_GATE_ENABLED": "true",
          "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
          "RATE_LIMITING_ENABLED": "true",
          "OWNER_PAGES_ON_ANY_HOST": "true"
        },
        "ratelimits": [
          { "name": "AUTH_RATE_LIMITER", "namespace_id": "1292", "simple": { "limit": 10, "period": 60 } },
          { "name": "WRITE_RATE_LIMITER", "namespace_id": "1045", "simple": { "limit": 120, "period": 60 } },
          { "name": "CSP_REPORT_LIMITER", "namespace_id": "1042", "simple": { "limit": 10, "period": 60 } },

          { "name": "IMPORT_LIMITER", "namespace_id": "10492", "simple": { "limit": 2, "period": 60 } },

          { "name": "SIGN_IN_ACCOUNT_LIMITER", "namespace_id": "10493", "simple": { "limit": 5, "period": 60 } }
        ],
        "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
        "d1_databases": [
          { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
        ]
      }
    },
    // Like preview, but never deployed, so no rate limiting (no real client IP).
    "e2e": {
      "workers_dev": true,
      "routes": [],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "e2e",
        "BETA_GATE_ENABLED": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
        "EMAIL_DELIVERY": "off",
        // admin.localhost has no Cloudflare Access in front of it.
        "ADMIN_ACCESS_CHECK": "off"
      },
      "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ]
    },
    "beta": {
      "routes": [
        { "pattern": "beta.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "vars": {
        "APP_ENV": "beta",
        "BETA_GATE_ENABLED": "true",
        "RATE_LIMITING_ENABLED": "true"
      },
      "ratelimits": [
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "1292", "simple": { "limit": 10, "period": 60 } },
        { "name": "WRITE_RATE_LIMITER", "namespace_id": "1045", "simple": { "limit": 120, "period": 60 } },
        { "name": "CSP_REPORT_LIMITER", "namespace_id": "1042", "simple": { "limit": 10, "period": 60 } },

        { "name": "IMPORT_LIMITER", "namespace_id": "10492", "simple": { "limit": 2, "period": 60 } },

        { "name": "SIGN_IN_ACCOUNT_LIMITER", "namespace_id": "10493", "simple": { "limit": 5, "period": 60 } }
      ],
      "durable_objects": { "bindings": [{ "name": "EMAIL_LIMITER", "class_name": "RecipientEmailLimiter" }] },
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
      ]
    }
  }
}
