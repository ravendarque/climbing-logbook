{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "climbing-logbook",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  // Better Auth (#20) depends on Node.js built-ins (e.g. node:crypto) not
  // natively available in the Workers runtime otherwise.
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  // binding: "ASSETS" (#348) -- lets src/api/owned-routes.js fetch a
  // fixed-path static shell (e.g. public/log/index.html) from inside the
  // Worker for the dynamic-:username routes Static Assets can't match by
  // itself (it only matches literal paths). Doesn't change routing
  // priority for any other static file: without run_worker_first (left
  // unset, default false), a request that DOES match a real static file
  // is still served directly without invoking the Worker at all, exactly
  // as before -- confirmed against Cloudflare's own docs, not assumed.
  //
  // run_worker_first (#407): the shell files above were also incidentally
  // reachable directly at their own literal disk path (/log, /map,
  // /performance, /profile, with no :username segment) -- asset-first
  // serving doesn't know these files are meant only to be fetched
  // internally via the ASSETS binding, from inside the session-checked
  // routes above. #302 adds /account, /account/edit to this same list --
  // same bare-path-reachability gap, since owned-routes.js's SHELL_PATHS
  // now serves those too. Scoped to just these paths (an array, not the
  // global `true`) so every other static file keeps today's free
  // asset-first perf/cost -- confirmed the array form is supported at
  // the pinned wrangler version (4.115.0) via
  // node_modules/wrangler/config-schema.json, not assumed. Forcing these
  // through the Worker is enough on its own: src/index.js has no route
  // matching a bare "/log"/"/map"/"/performance"/"/profile"/"/account"
  // pathname (the dynamic my.<domain>/:username/{log,map,performance,
  // account(/edit)?} regex always requires a username segment first), so
  // these now simply fall through to the same final "Not found" 404 every
  // other unmatched path gets -- no new route-matching code needed.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/log", "/log/*",
      "/map", "/map/*",
      "/performance", "/performance/*",
      "/profile", "/profile/*",
      "/account", "/account/*"
    ]
  },
  // Better Auth (#20) + the eventual multi-tenant app data (#21) -- id is a
  // placeholder until infra/d1.tf's Terraform apply provisions the real
  // database and infra.yml's sync step rewrites it. Placeholder is
  // harmless for local dev/Vitest -- both run against a local
  // Miniflare-simulated D1, which doesn't need the id to correspond to a
  // real remote database.
  "d1_databases": [
    { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook", "database_id": "8f094438-520c-4a67-a685-aee3db6198ad", "migrations_dir": "migrations" }
  ],
  // Beta invite/registration gate (#296) -- not a secret, so `vars` (not
  // `.dev.vars`) is the right place. Flipping this to "false" here is the
  // entire "go fully public" mechanism once the beta period ends (#296) --
  // no code change needed. Explicitly duplicated into env.preview below,
  // not left to inherit -- `vars` is NOT inherited by named environments
  // (confirmed via `wrangler deploy --dry-run`'s own warning, 2026-08-06;
  // a prior version of this comment claimed the opposite, which appears
  // to have meant every PR preview silently ran with BETA_GATE_ENABLED
  // undefined -- falsy, so the gate was never actually enforced there).
  "vars": {
    "BETA_GATE_ENABLED": "true"
  },
  // #295 -- climbinglogbook.com/my.climbinglogbook.com are the real
  // routes. The ravendarque.com/logbook* Workers Route that used to sit
  // alongside them is gone (#453) -- it was already confirmed dead for
  // real traffic (infra/redirects.tf's own Terraform-managed, zone-level
  // redirect ruleset runs ahead of Workers Routes at the edge and always
  // wins, so this entry never actually served anything once that
  // ruleset existed), and once #316 narrowed CLOUDFLARE_API_TOKEN's
  // scope back to climbinglogbook.com only, `wrangler deploy`'s routine
  // per-deploy route reconciliation against the ravendarque.com zone
  // started failing outright on every deploy (confirmed: the token can
  // no longer authenticate for that zone at all). Removing the entry
  // stops wrangler from ever needing to touch that zone again -- no
  // Terraform change needed, nothing depended on this Workers Route
  // existing (confirmed via grep: no cloudflare_workers_route resource
  // anywhere, redirects.tf only mentions it in a comment).
  "routes": [
    { "pattern": "climbinglogbook.com/*", "zone_name": "climbinglogbook.com" },
    { "pattern": "my.climbinglogbook.com/*", "zone_name": "climbinglogbook.com" }
  ],
  "observability": {
    "enabled": true
  },
  // PR preview deployments (#222) -- `wrangler versions upload --env preview`
  // in CI (see .github/workflows/preview.yml) uploads a version of a
  // *separate* Worker script (Wrangler appends the environment name --
  // this becomes "climbing-logbook-preview", not "climbing-logbook") bound
  // to its own D1 database, never the production one. `routes` is
  // explicitly overridden rather than left to inherit from the top level
  // -- routes/workers_dev are inheritable by default, and while `versions
  // upload` (unlike `deploy`) never actually attaches a route to traffic,
  // there's no reason to leave the production route pattern sitting in
  // the preview env's config at all.
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
      // BETA_GATE_ENABLED: same value as the top-level `vars` above,
      // duplicated deliberately -- `vars` is not inherited by named
      // environments (see that block's own comment for how this was
      // discovered).
      //
      // TURNSTILE_SECRET_KEY (#311): Cloudflare's own public "always
      // passes" test secret, not the real production one -- preview
      // deployments are disposable/test data anyway (same reasoning as
      // the preview D1 database below), and committing this specific
      // value is safe since Cloudflare documents it publicly for exactly
      // this purpose (never do this with the real secret). Deliberately
      // has no equivalent at the top level -- production gets the real
      // value via `wrangler secret put` only, no `vars` default.
      "vars": {
        "BETA_GATE_ENABLED": "true",
        "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
      },
      // Own D1 database, disposable preview data -- manually bootstrapped
      // (`wrangler d1 create climbing-logbook-preview`), not
      // Terraform-managed (unlike production's own `infra/d1.tf`). Was
      // previously missing entirely: `d1_databases` isn't
      // inheritable-but-overridden like `vars`/`routes` are documented to
      // be here, it's inheritable-and-left-alone, which silently pointed
      // every PR preview at the *production* database once #21 gave
      // LOGBOOK_DB a real id (harmless placeholder before that; a real
      // shared-data risk after). Caught 2026-08-05 when Raven asked for
      // #320's PR preview login credentials -- there weren't any, and
      // signing up there would have written into production.
      "d1_databases": [
        { "binding": "LOGBOOK_DB", "database_name": "climbing-logbook-preview", "database_id": "845753a5-abfc-4d74-995b-94d802b4964e", "migrations_dir": "migrations" }
      ]
    }
  }
}
